# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Any script reads these by name via `config.get(...)` (see config.py).

# --- Yahoo Fantasy Sports API -------------------------------------------------
# Fantasy API access is now approval-gated: apply at
#   https://sports.yahoo.com/developer/access/   (read-only; write access is
#   discontinued). Until Yahoo approves, every fantasy endpoint 401s with
#   oauth_problem="additional_authorization_required". The old self-serve
#   "Fantasy Sports -> Read" permission checkbox no longer appears in the app UI.
# Create the OAuth app at https://developer.yahoo.com/apps/create/ with a HTTPS
# Redirect URI matching the value below, then copy its Client ID / Secret here.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Must match the app's registered Redirect URI exactly. Yahoo rejects plain http,
# so this is https even though it points at your own machine. `bin/yahoo-auth
# login` starts a local listener here (self-signed cert -> click past the browser
# warning); if that fails, `bin/yahoo-auth login --manual` prints the URL and you
# paste the ?code= value back.
YAHOO_REDIRECT_URI=https://localhost:8000/callback

# Optional overrides:
# YAHOO_SCOPE=                                    # leave empty; try fspt-r only if a
#                                                 # post-approval token still 401s
# YAHOO_TOKEN_PATH=data/cache/yahoo_token.json   # relative paths are repo-root-relative
# YAHOO_LEAGUE_ID=236625                          # "keepitcrooked"; default for the CLI
